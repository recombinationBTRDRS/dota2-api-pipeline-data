# ── OpenDota API ────────────────────────────────────────────────
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_RATE_LIMIT=60    # requests per minute (free tier = 60)
OPENDOTA_TIMEOUT=30       # HTTP timeout in seconds
OPENDOTA_RETRIES=3        # retry attempts on 429/5xx

# ── Match Discovery (Epic 2) ─────────────────────────────────────
DISCOVERY_LOBBY_TYPE=7    # 7 = ranked matchmaking
DISCOVERY_MIN_MMR=3000    # minimum average MMR
DISCOVERY_LIMIT=100       # matches per discovery query
# DISCOVERY_PATCH=        # leave empty for latest patch
# DISCOVERY_REGION=       # leave empty for all regions

# ── Database ─────────────────────────────────────────────────────
DB_PATH=services/ingestion/db/data.sqlite

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
