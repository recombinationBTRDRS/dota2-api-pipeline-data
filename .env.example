# ── OpenDota API ────────────────────────────────────────────────
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_RATE_LIMIT=60
OPENDOTA_TIMEOUT=30
OPENDOTA_RETRIES=3

# ── Match Discovery (Epic 2 / Epic 7.1) ─────────────────────────
DISCOVERY_LOBBY_TYPE=7
# avg_mmr видалено з OpenDota. Використовуємо avg_rank_tier:
# 60=Ancient+, 70=Divine+, 80=Immortal+
DISCOVERY_MIN_RANK_TIER=60
DISCOVERY_LIMIT=100
DISCOVERY_INTERVAL_SEC=300
# DISCOVERY_PATCH=
# DISCOVERY_REGION=

# ── Database ─────────────────────────────────────────────────────
DB_PATH=services/ingestion/db/data.sqlite

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS (Epic 6.6) ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
